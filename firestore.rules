rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /rfq_sync/{rfqId} {
      allow read: if isAuthenticated() && (
        resource.data.customerUserId == request.auth.uid ||
        request.auth.uid in resource.data.assignedVendorIds
      );
      allow create: if isAuthenticated() && request.resource.data.customerUserId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.customerUserId == request.auth.uid ||
        request.auth.uid in resource.data.assignedVendorIds
      );
      allow delete: if isAuthenticated() && resource.data.customerUserId == request.auth.uid;
    }

    match /quotes_sync/{quoteId} {
      allow read: if isAuthenticated() && (
        resource.data.vendorId == request.auth.uid ||
        resource.data.customerUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.vendorId == request.auth.uid ||
        resource.data.customerUserId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.vendorId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

