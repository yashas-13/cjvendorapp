# ============================================================================
# CJ FABRICATIONS — ENVIRONMENT CONFIGURATION TEMPLATE
# Instructions: Copy this file to .env and supply actual deployment values.
# NEVER commit secrets or production database credentials to source control.
# ============================================================================

# Application Environment
NODE_ENV=production
PORT=3010
HOST=127.0.0.1
CORS_ORIGIN=https://parkzone.in

# Authoritative PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cjfabrication
DB_USER=cjfab_app
DB_PASSWORD=YOUR_POSTGRES_SECURE_PASSWORD

# JWT & Authentication Secrets
JWT_SECRET=YOUR_RANDOM_64_CHAR_HEX_SECRET_KEY
JWT_EXPIRY=7d

# WhatsApp Integration
# Business helpline number in E.164 format without '+' (e.g., 919876543210)
WHATSAPP_BUSINESS_PHONE=919876543210
WHATSAPP_API_TOKEN=YOUR_OPTIONAL_META_WHATSAPP_CLOUD_API_TOKEN

# File Uploads (CAD drawings, site photos, PDF specs)
UPLOAD_STORAGE_PATH=/var/www/cjfabrication/uploads
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB per file
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/dxf

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
